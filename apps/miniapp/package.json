{
  "name": "@foodlog/miniapp",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "FoodLog Telegram Mini App: camera-first capture, confirm, and local save (mock processor).",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.typecheck.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test": "vitest run",
    "deploy": "wrangler pages deploy dist --project-name=foodlog --branch=main --commit-dirty=true"
  },
  "dependencies": {
    "@foodlog/core": "workspace:*",
    "@telegram-apps/sdk-react": "^3.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "typescript": "^5.6.3",
    "vite": "^6.0.5",
    "vitest": "^2.1.8",
    "wrangler": "^3.99.0"
  }
}
