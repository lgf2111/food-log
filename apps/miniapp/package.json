{
  "name": "@snapbite/miniapp",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "FoodLog Telegram Mini App: review, edit, search, and analyze logged meals.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.typecheck.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test": "vitest run",
    "deploy": "wrangler pages deploy dist --project-name=snapbite --branch=main --commit-dirty=true"
  },
  "dependencies": {
    "@snapbite/core": "workspace:*",
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-label": "^2.1.1",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-slot": "^1.1.1",
    "@radix-ui/react-tabs": "^1.1.2",
    "@telegram-apps/sdk-react": "^3.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.469.0",
    "react": "^19.0.0",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.0.0",
    "react-swipeable": "^7.0.2",
    "sonner": "^1.7.1",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "tailwindcss": "^4.0.0",
    "tw-animate-css": "^1.2.0",
    "typescript": "^5.6.3",
    "vite": "^6.0.5",
    "vitest": "^2.1.8",
    "wrangler": "^3.99.0"
  }
}
